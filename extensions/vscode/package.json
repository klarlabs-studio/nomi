{
  "name": "nomi",
  "displayName": "Nomi",
  "description": "Thin client for Nomi reviewable agents — approve plans and tool calls without leaving the editor.",
  "version": "0.1.0",
  "publisher": "klarlabs",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "nomi",
    "agent",
    "approval",
    "plan review",
    "mcp"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Nomi",
      "properties": {
        "nomi.apiUrl": {
          "type": "string",
          "default": "",
          "description": "Override nomid base URL (default: read api.endpoint from the Nomi data dir, else http://127.0.0.1:8080)."
        },
        "nomi.token": {
          "type": "string",
          "default": "",
          "description": "Override bearer token (default: $NOMI_TOKEN or auth.token in the Nomi data dir). Prefer the Secret Storage command for remote hosts."
        },
        "nomi.dataDir": {
          "type": "string",
          "default": "",
          "description": "Override Nomi data directory (default: $NOMI_DATA_DIR or OS app-data path)."
        },
        "nomi.pollIntervalMs": {
          "type": "number",
          "default": 15000,
          "minimum": 3000,
          "description": "How often to refresh the pending badge when SSE is unavailable."
        },
        "nomi.defaultAssistantId": {
          "type": "string",
          "default": "",
          "description": "Assistant ID used by Nomi: Run with editor context. Leave empty to pick from a Quick Pick."
        }
      }
    },
    "commands": [
      {
        "command": "nomi.refresh",
        "title": "Nomi: Refresh pending"
      },
      {
        "command": "nomi.showPending",
        "title": "Nomi: Show pending approvals & plans"
      },
      {
        "command": "nomi.approveSelected",
        "title": "Nomi: Approve selected"
      },
      {
        "command": "nomi.denySelected",
        "title": "Nomi: Deny selected"
      },
      {
        "command": "nomi.openStatus",
        "title": "Nomi: Daemon status"
      },
      {
        "command": "nomi.runWithEditorContext",
        "title": "Ask Nomi",
        "category": "Nomi"
      },
      {
        "command": "nomi.reviewPlan",
        "title": "Nomi: Review pending plan"
      },
      {
        "command": "nomi.showProgress",
        "title": "Nomi: Show run progress"
      },
      {
        "command": "nomi.cancelRun",
        "title": "Nomi: Cancel active run"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "nomi.runWithEditorContext",
          "when": "editorTextFocus",
          "group": "nomi@1"
        }
      ],
      "commandPalette": [
        {
          "command": "nomi.runWithEditorContext",
          "when": "true"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nomi.runWithEditorContext",
        "key": "ctrl+shift+alt+n",
        "mac": "cmd+shift+alt+n",
        "when": "editorTextFocus"
      },
      {
        "command": "nomi.reviewPlan",
        "key": "ctrl+shift+alt+r",
        "mac": "cmd+shift+alt+r"
      },
      {
        "command": "nomi.showPending",
        "key": "ctrl+shift+alt+p",
        "mac": "cmd+shift+alt+p"
      },
      {
        "command": "nomi.approveSelected",
        "key": "ctrl+shift+alt+y",
        "mac": "cmd+shift+alt+y"
      },
      {
        "command": "nomi.denySelected",
        "key": "ctrl+shift+alt+d",
        "mac": "cmd+shift+alt+d"
      },
      {
        "command": "nomi.cancelRun",
        "key": "ctrl+shift+alt+c",
        "mac": "cmd+shift+alt+c"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test out/discovery.test.js out/editor_context.test.js out/event_stream.test.js out/plan_fmt.test.js out/diff_hunks.test.js out/highlighter.test.js out/diff_render.test.js out/open_path.test.js out/step_progress.test.js out/cancel_run.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "shiki": "^4.4.3"
  }
}
